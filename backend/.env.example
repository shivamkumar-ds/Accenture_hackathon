# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

APP_NAME=BidOps AI
APP_ENV=development
DEBUG=true

# Postgres connection — used starting Milestone 0, Step 4.
DATABASE_URL=postgresql+psycopg2://bidops:bidops@localhost:5432/bidops

# JWT auth — generate a real random secret for anything beyond local dev,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Production note: if APP_ENV is anything other than "development", Settings
# refuses to start with this default value (see core/config.py's fail-fast
# validator) — this is a real, enforced check, not just documentation.
SECRET_KEY=dev-only-insecure-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed frontend origins. Defaults to the
# local Vite dev server if unset. Never a wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173

# LLM provider — "openai" (operational reference implementation: the only
# provider with a verified end-to-end Decision Engine run, see
# 99_DECISIONS_LOG.md), "gemini" (Vertex AI mode below is the strategic
# long-term provider, still pending real production verification), "qwen"
# (frozen — Alibaba Cloud/DashScope is unreachable for new accounts from
# this deployment's region; kept working, not deleted), or "mock" (local
# testing without credentials, and the actual code-level default — every
# real provider is opt-in via explicit configuration, per ADR-001).
LLM_PROVIDER=openai

# OpenAI (operational reference implementation) — real API key from
# platform.openai.com. No `temperature` override is sent (GPT-5-series
# models reject any non-default value) — determinism comes from
# schema-constrained prompts, not sampling temperature.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_SECONDS=1.0

# Gemini / Vertex AI (strategic long-term provider — pending real
# production verification of the Decision Engine specifically; see
# 99_DECISIONS_LOG.md D-141/D-142). Get a Developer API key from Google AI
# Studio (https://aistudio.google.com/apikey) for "developer" auth mode.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Gemini provider robustness — same conservative posture as the others,
# implemented via the `google-genai` SDK's own built-in retry mechanism
# rather than a hand-rolled loop. GEMINI_MAX_RETRY_DELAY_SECONDS is the
# backoff ceiling the SDK's retry mechanism requires explicitly.
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SECONDS=1.0
GEMINI_MAX_RETRY_DELAY_SECONDS=30.0

# Gemini auth mode. "developer" (default) is the plain-API-key path above --
# keep it for local dev, zero GCP setup needed. "vertex" switches to Vertex
# AI mode: Application Default Credentials (ADC) only, no API key, no JSON
# service-account key file. Requires GOOGLE_CLOUD_PROJECT;
# GOOGLE_CLOUD_LOCATION defaults to us-central1 (region decision
# deliberately deferred -- see 99_DECISIONS_LOG.md).
GEMINI_AUTH_MODE=developer
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Qwen (frozen, M11) — real DashScope API key from Alibaba Cloud, only
# usable where DashScope is reachable for your account/region.
QWEN_API_KEY=your-dashscope-api-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Qwen provider robustness (M11) — conservative, production-reasonable
# defaults. Retries are bounded and only apply to transient
# provider/network failures (timeouts, connection errors, rate limits);
# authentication failures and malformed responses are never retried.
QWEN_TIMEOUT_SECONDS=30.0
QWEN_MAX_RETRIES=3
QWEN_RETRY_BACKOFF_SECONDS=1.0

# Document storage — local disk for MVP.
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=50

# Freshness — no document specifies a number; 180 days (6 months) is the default.
CAPABILITY_STALENESS_DAYS=180

# Tender chunking — pages per LLM call during large-document analysis.
TENDER_CHUNK_PAGE_SIZE=5

# Decision Intelligence — optional issues above this count push the
# recommendation to REVIEW rather than GO.
MAX_OPTIONAL_REVIEW_ITEMS=2
