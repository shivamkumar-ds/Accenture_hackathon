VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Authentication (Phase 2) — the same OAuth 2.0 Client ID
# configured as GOOGLE_OAUTH_CLIENT_ID on the backend. This one IS
# meant to be public (embedded in the built frontend bundle, visible to
# anyone) -- that's how Google's own Identity Services library expects
# it to be used. Unset: the Login page's Google button keeps its
# existing "coming soon" placeholder behavior, nothing breaks.
VITE_GOOGLE_CLIENT_ID=
